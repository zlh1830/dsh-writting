{
  "name": "dsh-train-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "npm@11.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --configLoader native --pool=threads",
    "build": "npm run build -w @local/dsh-train-core && npm run build -w @local/dsh-train-coach-local && npm run build -w @local/dsh-train-questionbank && npm run build -w @local/dsh-train-judge-cloud && npm run build -w @local/dsh-train-writing",
    "check:client": "node scripts/check-client.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify": "npm run check:privacy && npm run check:docs && npm run typecheck && npm test && npm run build && npm run check:client"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@rolldown/pluginutils": "^1.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "ansis": "4.5.0",
    "cac": "^7.1.0",
    "defu": "^6.1.7",
    "dts-resolver": "^3.0.0",
    "empathic": "^2.1.0",
    "fdir": "^6.5.0",
    "get-tsconfig": "5.0.0-beta.6",
    "hookable": "^6.1.2",
    "import-without-cache": "^0.4.1",
    "obug": "^3.0.0",
    "picomatch": "^4.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "resolve-pkg-maps": "^1.0.0",
    "rolldown": "^1.2.16",
    "rolldown-plugin-dts": "^0.29.0",
    "tinyexec": "^1.3.1",
    "tinyglobby": "^0.2.17",
    "tree-kill": "^1.2.2",
    "tsdown": "^0.22.2",
    "typescript": "5.9.3",
    "unconfig-core": "^7.5.0",
    "verkit": "^0.5.0",
    "vitest": "^4.1.8",
    "yuku": "^0.27.0"
  }
}
